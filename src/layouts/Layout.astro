---
// src/layouts/Layout.astro
import EditorialNavbar from "../components/EditorialNavbar.astro";
import NewspaperDesk from "../components/NewspaperDesk.astro";

const {
  title = "Gabriel Escobar | The Developer Gazette",
  description = "Portafolio Profesional de Desarrollo de Software • Tecnólogo en Software (EPN)"
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts para tipografía de prensa clásica -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700;900&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,700;1,6..72,400&family=Playfair+Display:wght@700;900&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
    <meta name="description" content={description} />
  </head>

  <body class="min-h-screen bg-[#f3ecdb] text-[#1a1614] antialiased selection:bg-[#ebd9bd] selection:text-[#1c1714] overflow-x-hidden">
    <EditorialNavbar />
    <NewspaperDesk>
      <slot />
    </NewspaperDesk>
  </body>
</html>