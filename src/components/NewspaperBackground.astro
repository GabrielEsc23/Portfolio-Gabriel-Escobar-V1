---
// src/components/NewspaperBackground.astro
---

<div class="newspaper-desk">
  <!-- Hoja principal del Periódico -->
  <main class="newspaper-sheet">
    <!-- CAPAS DE TEXTURA Y FÍSICA (no interactivas) -->
    <div class="sheet-overlays" aria-hidden="true">
      <!-- Textura de fibra de papel y grano -->
      <div class="paper-texture"></div>

      <!-- Pliegue central horizontal ("The Fold") característico de la prensa -->
      <div class="paper-fold-horizontal"></div>

      <!-- Pliegue sutil vertical (lomo del periódico) -->
      <div class="paper-fold-vertical"></div>

      <!-- Arrugas suaves y dobleces diagonales -->
      <div class="paper-wrinkles"></div>

      <!-- Mancha de café muy tenue en la esquina inferior (detalle de lectura) -->
      <div class="paper-coffee-stain"></div>

      <!-- Pátina de tiempo y manchas de tinta difusas en márgenes -->
      <div class="paper-aging-stains"></div>

      <!-- Iluminación natural sobre la mesa -->
      <div class="paper-lighting"></div>

      <!-- Amarilleo y oxidación en los 4 bordes del papel -->
      <div class="paper-vignette-edges"></div>

      <!-- Marcas de imprenta tradicionales en los márgenes exteriores -->
      <div class="press-marks top-left" aria-hidden="true">
        <span class="reg-cross">+</span>
      </div>
      <div class="press-marks top-right" aria-hidden="true">
        <span class="reg-cross">+</span>
      </div>
      <div class="press-marks bottom-left" aria-hidden="true">
        <span class="reg-cross">+</span>
      </div>
      <div class="press-marks bottom-right" aria-hidden="true">
        <span class="reg-cross">+</span>
        <div class="cmyk-patches">
          <span class="patch patch-c"></span>
          <span class="patch patch-m"></span>
          <span class="patch patch-y"></span>
          <span class="patch patch-k"></span>
        </div>
      </div>
    </div>

    <!-- CONTENEDOR DEL CONTENIDO REAL (Lectura nítida 100% accesible) -->
    <div class="newspaper-content">
      <slot />
    </div>
  </main>
</div>

<style>
  /*
   * 1. SUPERFICIE DE LA MESA (DESK)
   * Un tono oscuro, cálido y elegante que hace que la hoja de papel crema
   * resalte con sensación tridimensional física.
   */
  .newspaper-desk {
    position: relative;
    width: 100%;
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 36px 16px;
    background-color: #1a1816;
    background-image:
      radial-gradient(ellipse at 50% 20%, rgba(55, 48, 42, 0.6) 0%, rgba(18, 16, 14, 0.95) 85%),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.012) 0px,
        rgba(255, 255, 255, 0.012) 2px,
        transparent 2px,
        transparent 8px
      );
    background-attachment: fixed;
    overflow-x: hidden;
  }

  /*
   * 2. HOJA DE PERIÓDICO (SHEET)
   * Tono crema auténtico de pulpa de prensa (#f6f1e3),
   * con ligerísima inclinación orgánica y sombra multicapa.
   */
  .newspaper-sheet {
    position: relative;
    width: min(1220px, 100%);
    min-height: calc(100vh - 72px);
    background-color: #f5efe1;
    background-image:
      radial-gradient(ellipse at 50% 30%, #f9f5ea 0%, #f2e9d7 100%);
    
    /* Sombra realista de papel grueso reposando sobre superficie */
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.2),
      0 12px 28px -4px rgba(0, 0, 0, 0.45),
      0 30px 60px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(110, 85, 55, 0.18);

    /* Inclinación muy sutil para romper la rigidez digital */
    transform: rotate(-0.2deg);
    isolation: isolate;
    border-radius: 1px;
  }

  /*
   * 3. CAPAS SUPERPUESTAS DE TEXTURA
   */
  .sheet-overlays {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  /* Textura de celulosa y grano de imprenta */
  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: url("/paper-texture.svg");
    background-repeat: repeat;
    background-size: 380px 380px;
    opacity: 0.35;
    mix-blend-mode: multiply;
  }

  /*
   * 4. EL PLIEGUE PRINCIPAL ("THE FOLD")
   * La clave visual más reconocible de la prensa física:
   * una sombra en hendidura combinada con un realce de luz en la cresta.
   */
  .paper-fold-horizontal {
    position: absolute;
    top: 40%;
    left: 0;
    right: 0;
    height: 14px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(70, 50, 30, 0.03) 25%,
      rgba(60, 42, 22, 0.13) 48%,
      rgba(255, 255, 250, 0.38) 52%,
      rgba(255, 255, 250, 0.12) 75%,
      transparent 100%
    );
    filter: blur(1.5px);
    opacity: 0.9;
  }

  /* Pliegue vertical sutil (apertura de pliego) */
  .paper-fold-vertical {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 20px;
    transform: translateX(-50%);
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(60, 45, 25, 0.05) 46%,
      rgba(255, 255, 245, 0.25) 54%,
      transparent 100%
    );
    filter: blur(2px);
    opacity: 0.75;
  }

  /* Arrugas y quiebres secundarios en el papel */
  .paper-wrinkles {
    position: absolute;
    inset: -10%;
    background:
      linear-gradient(
        115deg,
        transparent 0%,
        rgba(70, 50, 25, 0.035) 20%,
        rgba(255, 255, 245, 0.15) 23%,
        transparent 27%
      ),
      linear-gradient(
        160deg,
        transparent 40%,
        rgba(70, 50, 25, 0.045) 45%,
        rgba(255, 255, 245, 0.12) 47%,
        transparent 52%
      ),
      linear-gradient(
        65deg,
        transparent 65%,
        rgba(70, 50, 25, 0.03) 71%,
        rgba(255, 255, 245, 0.11) 73%,
        transparent 78%
      );
    filter: blur(3.5px);
    opacity: 0.75;
  }

  /* Detalle especial: Huella sutil de taza de café en esquina inferior derecha */
  .paper-coffee-stain {
    position: absolute;
    bottom: 6%;
    right: 4%;
    width: 140px;
    height: 140px;
    border-radius: 50%;
    border: 5px solid rgba(110, 75, 40, 0.08);
    box-shadow:
      inset 0 0 12px rgba(115, 80, 45, 0.05),
      0 0 10px rgba(115, 80, 45, 0.04);
    filter: blur(2px);
    transform: rotate(18deg) scaleY(0.95);
    opacity: 0.65;
    mix-blend-mode: multiply;
  }

  /* Manchas de envejecimiento orgánicas concentradas en márgenes */
  .paper-aging-stains {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 220px 140px at 8% 12%,
        rgba(100, 70, 35, 0.10) 0%,
        rgba(100, 70, 35, 0.04) 45%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 260px 160px at 92% 16%,
        rgba(95, 65, 30, 0.08) 0%,
        rgba(95, 65, 30, 0.03) 40%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 280px 180px at 15% 85%,
        rgba(100, 70, 35, 0.09) 0%,
        rgba(100, 70, 35, 0.03) 50%,
        transparent 75%
      ),
      radial-gradient(
        circle 90px at 85% 78%,
        rgba(90, 60, 28, 0.07) 0%,
        transparent 65%
      );
    filter: blur(14px);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  /* Iluminación suave que modela el relieve del periódico */
  .paper-lighting {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at 50% 35%,
        rgba(255, 255, 245, 0.28) 0%,
        transparent 65%
      ),
      radial-gradient(
        ellipse at 0% 100%,
        rgba(80, 55, 30, 0.08) 0%,
        transparent 50%
      );
    mix-blend-mode: soft-light;
  }

  /* Oxidación y oscurecimiento en los 4 bordes exteriores */
  .paper-vignette-edges {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(70, 50, 25, 0.18) 0%, rgba(70, 50, 25, 0.04) 2.5%, transparent 6%),
      linear-gradient(to left, rgba(70, 50, 25, 0.18) 0%, rgba(70, 50, 25, 0.04) 2.5%, transparent 6%),
      linear-gradient(to bottom, rgba(70, 50, 25, 0.22) 0%, rgba(70, 50, 25, 0.05) 2%, transparent 5%),
      linear-gradient(to top, rgba(70, 50, 25, 0.25) 0%, rgba(70, 50, 25, 0.06) 2%, transparent 5%);
    mix-blend-mode: multiply;
  }

  /*
   * 5. MARCAS DE IMPRENTA CLÁSICAS (REGISTRATION MARKS)
   */
  .press-marks {
    position: absolute;
    font-family: monospace;
    font-size: 11px;
    font-weight: bold;
    color: rgba(90, 70, 50, 0.4);
    user-select: none;
    line-height: 1;
  }

  .top-left {
    top: 8px;
    left: 12px;
  }

  .top-right {
    top: 8px;
    right: 12px;
  }

  .bottom-left {
    bottom: 8px;
    left: 12px;
  }

  .bottom-right {
    bottom: 8px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .reg-cross {
    display: inline-block;
    opacity: 0.55;
    letter-spacing: -1px;
  }

  .cmyk-patches {
    display: inline-flex;
    gap: 3px;
    padding-left: 4px;
    opacity: 0.6;
  }

  .patch {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .patch-c { background-color: #0088cc; }
  .patch-m { background-color: #cc0066; }
  .patch-y { background-color: #d4a017; }
  .patch-k { background-color: #333333; }

  /*
   * 6. CONTENEDOR DE CONTENIDO
   * Garantiza que el texto sea nítido, legible y no quede aplastado por los efectos.
   */
  .newspaper-content {
    position: relative;
    z-index: 10;
    width: 100%;
    padding: 32px 28px;
    color: #1a1614; /* Tinta negra cálida de imprenta */
  }

  @media (min-width: 640px) {
    .newspaper-content {
      padding: 44px 40px;
    }
  }

  @media (min-width: 1024px) {
    .newspaper-content {
      padding: 56px 56px;
    }
  }

  @media (max-width: 768px) {
    .newspaper-desk {
      padding: 16px 8px;
    }

    .newspaper-sheet {
      transform: none; /* Mejor lectura en móviles */
    }

    .paper-fold-horizontal {
      top: 35%;
    }

    .paper-coffee-stain {
      display: none; /* Ocultar en pantallas muy pequeñas para no distraer */
    }
  }
</style>