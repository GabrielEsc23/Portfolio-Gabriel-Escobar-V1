---
// src/components/EditorialNavbar.astro
import { cvData } from "../data/cv";

const navLinks = [
  { label: "Pág. 1: Portada", page: 1 },
  { label: "Pág. 2: Proyectos", page: 2 },
  { label: "Pág. 3: Habilidades", page: 3 },
  { label: "Pág. 4: Contacto", page: 4 },
];
---

<header class="sticky top-0 z-50 w-full bg-[#f6efe1]/95 backdrop-blur-md border-b-2 border-[#2b241e] text-[#1c1714] shadow-2xs transition-all">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-2 flex items-center justify-between">
    <!-- Logotipo / Cabecera compacta -->
    <button
      type="button"
      class="flex items-center gap-2 text-left group cursor-pointer"
      data-newspaper-goto="1"
    >
      <span class="text-xs font-mono tracking-widest text-[#8a3324] uppercase font-black">★ THE GAZETTE ★</span>
      <span class="hidden sm:inline text-xs text-[#6e5946]">•</span>
      <span class="hidden sm:inline font-headline font-bold text-sm tracking-wide text-[#1c1714] group-hover:text-[#8a3324] transition-colors">
        {cvData.perfil.nombre}
      </span>
    </button>

    <!-- Enlaces de navegación desktop (>= 768px) -->
    <nav class="hidden md:flex items-center gap-1 font-mono text-xs uppercase tracking-wider" aria-label="Navegación editorial">
      {navLinks.map((link) => (
        <button
          type="button"
          class="px-3 py-1.5 text-[#3d3126] font-bold hover:text-[#1c1714] hover:bg-[#ebd8bb] transition-all rounded-xs border border-transparent hover:border-[#4a3c30]/25 cursor-pointer"
          data-newspaper-goto={link.page}
        >
          {link.label}
        </button>
      ))}
    </nav>

    <!-- Botón directo de descarga de CV y menú móvil -->
    <div class="flex items-center gap-2">
      <a
        href={cvData.perfil.cvPdfUrl}
        download="Gabriel_Escobar_CV.pdf"
        class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#8a3324] hover:bg-[#a6402e] text-[#f7efe0] font-mono text-[11px] font-bold uppercase tracking-wider rounded-xs transition-colors border border-[#592218] shadow-xs"
        title="Descargar Currículum Vitae en PDF"
      >
        <span>Descargar CV</span>
        <span aria-hidden="true">↓</span>
      </a>

      <!-- Botón de menú móvil (< 768px) -->
      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden p-1.5 text-[#3d3126] hover:text-[#1c1714] focus:outline-none cursor-pointer"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-bars" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú desplegable para móviles -->
  <div id="mobile-menu-dropdown" class="hidden md:hidden bg-[#f0e5d1] border-t border-[#3d332a]/30 px-4 py-3 font-mono text-xs uppercase tracking-wider space-y-2 shadow-sm">
    {navLinks.map((link) => (
      <button
        type="button"
        class="mobile-nav-link block w-full text-left px-3 py-2 text-[#2c221a] font-bold hover:bg-[#e4d4ba] rounded-xs cursor-pointer"
        data-newspaper-goto={link.page}
      >
        {link.label}
      </button>
    ))}
  </div>
</header>

<script>
  function setupNavbar() {
    const toggleBtn = document.getElementById("mobile-menu-toggle");
    const dropdown = document.getElementById("mobile-menu-dropdown");
    const barsIcon = document.getElementById("menu-icon-bars");
    const closeIcon = document.getElementById("menu-icon-close");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    if (!toggleBtn || !dropdown) return;

    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true";
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded));
      dropdown.classList.toggle("hidden");
      barsIcon?.classList.toggle("hidden");
      closeIcon?.classList.toggle("hidden");
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        dropdown.classList.add("hidden");
        toggleBtn.setAttribute("aria-expanded", "false");
        barsIcon?.classList.remove("hidden");
        closeIcon?.classList.add("hidden");
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupNavbar, { once: true });
  } else {
    setupNavbar();
  }
</script>
