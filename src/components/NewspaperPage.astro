---
// src/components/NewspaperPage.astro
interface Props {
  pageNumber: number;
  totalPages?: number;
  sectionName: string;
  issueNumber?: string;
  date?: string;
  class?: string;
}

const {
  pageNumber,
  totalPages = 4,
  sectionName,
  issueNumber = "Vol. I — 2026",
  date = "Edición Especial",
  class: className = ""
} = Astro.props;
---

<article
  class={`newspaper-page-sheet ${className}`}
  id={`page-${pageNumber}`}
  data-page-index={pageNumber}
  data-section-name={sectionName}
>
  <!-- CAPAS DE TEXTURA Y FÍSICA -->
  <div class="sheet-overlays" aria-hidden="true">
    <div class="paper-texture"></div>
    <div class="paper-fold-horizontal"></div>
    <div class="paper-fold-vertical"></div>
    <div class="paper-wrinkles"></div>
    <div class="paper-aging-stains"></div>
    <div class="paper-lighting"></div>
    <div class="paper-vignette-edges"></div>

    <!-- Marcas de imprenta tradicionales -->
    <div class="press-marks top-left"><span class="reg-cross">+</span></div>
    <div class="press-marks top-right"><span class="reg-cross">+</span></div>
    <div class="press-marks bottom-left"><span class="reg-cross">+</span></div>
    <div class="press-marks bottom-right">
      <span class="reg-cross">+</span>
      <div class="cmyk-patches">
        <span class="patch patch-c"></span>
        <span class="patch patch-m"></span>
        <span class="patch patch-y"></span>
        <span class="patch patch-k"></span>
      </div>
    </div>
  </div>

  <!-- ENCABEZADO DE FOLIO DE PÁGINA (PAGINACIÓN EDITORIAL) -->
  <div class="newspaper-folio-top border-b border-[#2e261f]/40 pb-2 mb-4 sm:mb-6">
    <div class="flex items-center justify-between text-[10px] sm:text-[11px] font-mono uppercase tracking-widest text-[#5c4a3b]">
      <div class="flex items-center gap-2">
        {pageNumber > 1 && (
          <button
            type="button"
            class="font-bold text-[#8a3324] hover:text-[#1c1714] cursor-pointer flex items-center gap-1 bg-[#ecd9bd] px-2 py-0.5 border border-[#4a3a2d]/30 rounded-xs shadow-2xs transition-colors"
            data-newspaper-goto={pageNumber - 1}
            title={`Volver a Hoja ${pageNumber - 1}`}
          >
            <span>← Pág. {pageNumber - 1}</span>
          </button>
        )}
        <span class={pageNumber > 1 ? "hidden sm:inline" : ""}>{issueNumber} • The Developer Gazette</span>
      </div>
      <span class="font-bold tracking-widest text-[#241d18]">§ {sectionName}</span>
      <span>Pág. {pageNumber} de {totalPages}</span>
    </div>
  </div>

  <!-- CONTENIDO EDITORIAL DE LA PÁGINA -->
  <div class="page-body">
    <slot />
  </div>

  <!-- PIE DE PÁGINA DE IMPRENTA CON ENLACES DE NAVEGACIÓN -->
  <footer class="newspaper-folio-bottom mt-8 pt-3 pb-8 sm:pb-2 border-t border-[#2e261f]/40 flex flex-wrap items-center justify-between text-[11px] font-mono text-[#5c4a3b] uppercase tracking-wider gap-2">
    <div>
      {pageNumber > 1 ? (
        <button
          type="button"
          class="page-nav-link hover:text-[#1c1714] hover:underline cursor-pointer flex items-center gap-1 font-bold bg-[#ede0cb] px-3 py-1.5 border border-[#3d3126]/30 shadow-2xs rounded-xs transition-colors"
          data-newspaper-goto={pageNumber - 1}
        >
          <span>← Hoja Anterior ({pageNumber - 1})</span>
        </button>
      ) : (
        <span>Quito, Ecuador • EPN</span>
      )}
    </div>

    <div class="text-center font-bold text-[#3d3126]">
      <span>— Hoja {pageNumber} de {totalPages} —</span>
    </div>

    <div>
      {pageNumber < totalPages ? (
        <button
          type="button"
          class="page-nav-link hover:text-[#1c1714] hover:underline cursor-pointer flex items-center gap-1.5 font-bold bg-[#8a3324] hover:bg-[#a33f2e] text-[#f7efe0] px-4 py-2 border border-[#541f16] shadow-xs rounded-xs transition-colors"
          data-newspaper-goto={pageNumber + 1}
        >
          <span>Pasar a Pág. {pageNumber + 1}</span>
          <span aria-hidden="true">→</span>
        </button>
      ) : (
        <span class="font-bold text-[#3d3126]">★ Fin de la Edición ★</span>
      )}
    </div>
  </footer>

  <!-- PESTAÑA DE ESQUINA DOBLADA (DOG-EAR) PARA PASAR PÁGINA -->

</article>

<style>
  /* Estilos base de la hoja */
  .newspaper-page-sheet {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: min(1180px, 96vw);
    max-height: calc(100vh - 76px);
    overflow-y: auto;
    overflow-x: hidden;
    -webkit-overflow-scrolling: touch;
    background-color: #f5efe1;
    background-image: radial-gradient(ellipse at 50% 30%, #f9f5ea 0%, #f2e9d7 100%);
    box-shadow:
      0 2px 8px rgba(70, 50, 30, 0.08),
      0 12px 28px -6px rgba(70, 50, 30, 0.14),
      0 22px 50px -12px rgba(60, 42, 22, 0.16),
      0 0 0 1px rgba(90, 70, 45, 0.24);
    border-radius: 2px;
    padding: 24px 20px 32px 20px;
    isolation: isolate;
    transform-origin: center bottom;
  }

  @media (min-width: 768px) {
    .newspaper-page-sheet {
      padding: 38px 44px 28px 44px;
      max-height: calc(100vh - 84px);
    }
  }

  /* Scrollbar sutil estilo vintage */
  .newspaper-page-sheet::-webkit-scrollbar {
    width: 5px;
  }
  .newspaper-page-sheet::-webkit-scrollbar-track {
    background: rgba(80, 60, 40, 0.05);
  }
  .newspaper-page-sheet::-webkit-scrollbar-thumb {
    background: rgba(110, 85, 55, 0.35);
    border-radius: 2px;
  }

  /*
   * ESTADOS DE LA HOJA:
   * 1. .sheet-active: visible en primer plano
   * 2. .sheet-queued / .sheet-hidden-*: ocultas
   * 3. .sheet-slide-out-left / .sheet-slide-in-right: transiciones fluidas de paso de página
   */
  .newspaper-page-sheet.sheet-active {
    display: block !important;
    opacity: 1;
    z-index: 20;
    pointer-events: auto;
    transform: translateX(-50%) scale(1);
  }

  .newspaper-page-sheet.sheet-queued {
    display: none !important;
    opacity: 0;
    z-index: 10;
    pointer-events: none;
  }

  .newspaper-page-sheet.sheet-hidden-left {
    display: none !important;
    opacity: 0;
    z-index: 5;
    pointer-events: none;
    transform: translateX(calc(-50% - 60px)) scale(0.96);
  }

  .newspaper-page-sheet.sheet-hidden-right {
    display: none !important;
    opacity: 0;
    z-index: 5;
    pointer-events: none;
    transform: translateX(calc(-50% + 60px)) scale(0.96);
  }

  /* ANIMACIONES DE PASO DE HOJA FLUIDO */
  .newspaper-page-sheet.sheet-slide-out-left {
    display: block !important;
    z-index: 25;
    pointer-events: none;
    animation: sheetSlideOutLeft 0.42s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .newspaper-page-sheet.sheet-slide-in-right {
    display: block !important;
    z-index: 20;
    pointer-events: none;
    animation: sheetSlideInRight 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .newspaper-page-sheet.sheet-slide-out-right {
    display: block !important;
    z-index: 25;
    pointer-events: none;
    animation: sheetSlideOutRight 0.42s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .newspaper-page-sheet.sheet-slide-in-left {
    display: block !important;
    z-index: 20;
    pointer-events: none;
    animation: sheetSlideInLeft 0.42s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes sheetSlideOutLeft {
    0% {
      opacity: 1;
      transform: translateX(-50%) rotate(0deg) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateX(calc(-50% - 110px)) rotate(-2.5deg) scale(0.95);
    }
  }

  @keyframes sheetSlideInRight {
    0% {
      opacity: 0;
      transform: translateX(calc(-50% + 110px)) rotate(2.5deg) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) rotate(0deg) scale(1);
    }
  }

  @keyframes sheetSlideOutRight {
    0% {
      opacity: 1;
      transform: translateX(-50%) rotate(0deg) scale(1);
    }
    100% {
      opacity: 0;
      transform: translateX(calc(-50% + 110px)) rotate(2.5deg) scale(0.95);
    }
  }

  @keyframes sheetSlideInLeft {
    0% {
      opacity: 0;
      transform: translateX(calc(-50% - 110px)) rotate(-2.5deg) scale(0.95);
    }
    100% {
      opacity: 1;
      transform: translateX(-50%) rotate(0deg) scale(1);
    }
  }

  /* CURSOR DE MÁQUINA DE ESCRIBIR (TYPEWRITER) */
  :global(.typewriter-cursor) {
    display: inline-block;
    color: #8a3324;
    font-weight: 900;
    margin-left: 2px;
    animation: typewriterBlink 0.75s infinite steps(2, start);
    vertical-align: baseline;
    line-height: 1;
  }

  @keyframes typewriterBlink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }

  /* Capas de textura de papel */
  .sheet-overlays {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 1;
  }

  .paper-texture {
    position: absolute;
    inset: 0;
    background-image: url("/paper-texture.svg");
    background-repeat: repeat;
    background-size: 380px 380px;
    opacity: 0.32;
    mix-blend-mode: multiply;
  }

  .paper-fold-horizontal {
    position: absolute;
    top: 40%;
    left: 0;
    right: 0;
    height: 14px;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(70, 50, 30, 0.03) 25%,
      rgba(60, 42, 22, 0.13) 48%,
      rgba(255, 255, 250, 0.38) 52%,
      rgba(255, 255, 250, 0.12) 75%,
      transparent 100%
    );
    filter: blur(1.5px);
    opacity: 0.85;
  }

  .paper-fold-vertical {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 20px;
    transform: translateX(-50%);
    background: linear-gradient(
      to right,
      transparent 0%,
      rgba(60, 45, 25, 0.05) 46%,
      rgba(255, 255, 245, 0.25) 54%,
      transparent 100%
    );
    filter: blur(2px);
    opacity: 0.75;
  }

  .paper-wrinkles {
    position: absolute;
    inset: -10%;
    background:
      linear-gradient(115deg, transparent 0%, rgba(70, 50, 25, 0.03) 20%, rgba(255, 255, 245, 0.14) 23%, transparent 27%),
      linear-gradient(160deg, transparent 40%, rgba(70, 50, 25, 0.04) 45%, rgba(255, 255, 245, 0.11) 47%, transparent 52%),
      linear-gradient(65deg, transparent 65%, rgba(70, 50, 25, 0.025) 71%, rgba(255, 255, 245, 0.10) 73%, transparent 78%);
    filter: blur(3.5px);
    opacity: 0.7;
  }

  .paper-aging-stains {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 220px 140px at 8% 12%, rgba(100, 70, 35, 0.09) 0%, transparent 65%),
      radial-gradient(ellipse 260px 160px at 92% 16%, rgba(95, 65, 30, 0.07) 0%, transparent 65%),
      radial-gradient(ellipse 280px 180px at 15% 85%, rgba(100, 70, 35, 0.08) 0%, transparent 70%);
    filter: blur(14px);
    mix-blend-mode: multiply;
    opacity: 0.85;
  }

  .paper-lighting {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 35%, rgba(255, 255, 245, 0.25) 0%, transparent 65%);
    mix-blend-mode: soft-light;
  }

  .paper-vignette-edges {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(70, 50, 25, 0.16) 0%, rgba(70, 50, 25, 0.03) 2.5%, transparent 6%),
      linear-gradient(to left, rgba(70, 50, 25, 0.16) 0%, rgba(70, 50, 25, 0.03) 2.5%, transparent 6%),
      linear-gradient(to bottom, rgba(70, 50, 25, 0.18) 0%, rgba(70, 50, 25, 0.04) 2%, transparent 5%),
      linear-gradient(to top, rgba(70, 50, 25, 0.22) 0%, rgba(70, 50, 25, 0.05) 2%, transparent 5%);
    mix-blend-mode: multiply;
  }

  /* Marcas de imprenta */
  .press-marks {
    position: absolute;
    font-family: monospace;
    font-size: 11px;
    font-weight: bold;
    color: rgba(90, 70, 50, 0.4);
    user-select: none;
    line-height: 1;
  }

  .top-left { top: 8px; left: 12px; }
  .top-right { top: 8px; right: 12px; }
  .bottom-left { bottom: 8px; left: 12px; }
  .bottom-right {
    bottom: 8px;
    right: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .reg-cross { display: inline-block; opacity: 0.55; }
  .cmyk-patches { display: inline-flex; gap: 3px; padding-left: 4px; opacity: 0.6; }
  .patch { width: 6px; height: 6px; border-radius: 50%; }
  .patch-c { background-color: #0088cc; }
  .patch-m { background-color: #cc0066; }
  .patch-y { background-color: #d4a017; }
  .patch-k { background-color: #333333; }

  /* Contenido legible */
  .page-body {
    position: relative;
    z-index: 10;
    color: #1a1614;
  }

  .newspaper-folio-top,
  .newspaper-folio-bottom {
    position: relative;
    z-index: 10;
    user-select: none;
  }

  /* Pestaña de esquina doblada (Dog-ear) */
  .mobile-dog-ear {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 68px;
    height: 68px;
    cursor: pointer;
    z-index: 25;
    background: transparent;
    border: none;
    padding: 0;
    overflow: hidden;
  }

  .dog-ear-curl {
    position: absolute;
    bottom: 0;
    right: 0;
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 0 54px 54px;
    border-color: transparent transparent #ded1b8 transparent;
    filter: drop-shadow(-3px -3px 4px rgba(0, 0, 0, 0.35));
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .mobile-dog-ear:hover .dog-ear-curl {
    border-color: transparent transparent #d4c2a0 transparent;
    transform: scale(1.08);
  }

  .dog-ear-label {
    position: absolute;
    bottom: 6px;
    right: 3px;
    font-family: monospace;
    font-size: 8px;
    font-weight: 900;
    color: #423528;
    text-transform: uppercase;
    transform: rotate(-45deg);
    letter-spacing: 0.05em;
    pointer-events: none;
  }
</style>
