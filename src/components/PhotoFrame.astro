---
// src/components/PhotoFrame.astro
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image?: ImageMetadata | string;
  alt?: string;
  caption?: string;
  subcaption?: string;
}

const {
  image,
  alt = "Gabriel Escobar - Fotografía de Perfil",
  caption = "Gabriel Escobar — Desarrollador de Software",
  subcaption = "Fotografía Oficial del Ingeniero • Escuela Politécnica Nacional"
} = Astro.props;

// Detección automática y segura de foto en src/assets/
const assetImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/foto-perfil.{jpeg,jpg,png,webp,avif}",
  { eager: true }
);

const autoFoundImage =
  assetImages["/src/assets/foto-perfil.jpg"]?.default ||
  assetImages["/src/assets/foto-perfil.png"]?.default ||
  assetImages["/src/assets/foto-perfil.webp"]?.default ||
  assetImages["/src/assets/foto-perfil.jpeg"]?.default ||
  assetImages["/src/assets/foto-perfil.avif"]?.default;

const resolvedImage = image || autoFoundImage;
---

<figure class="newspaper-photo-frame">
  <div class="photo-inner-border">
    {resolvedImage ? (
      typeof resolvedImage === "string" ? (
        <img
          src={resolvedImage}
          alt={alt}
          width={320}
          height={384}
          class="vintage-photo"
          loading="eager"
          fetchpriority="high"
        />
      ) : (
        <Image
          src={resolvedImage}
          alt={alt}
          width={320}
          height={384}
          widths={[280, 320, 480, 600]}
          sizes="(max-width: 480px) 280px, (max-width: 640px) 320px, 320px"
          format="webp"
          quality={68}
          class="vintage-photo"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )
    ) : (
      <div class="photo-placeholder">
        <svg class="w-16 h-16 text-[#6e5842] opacity-70 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span class="font-mono text-xs uppercase tracking-widest font-bold text-[#3d3126]">
          Espacio para Fotografía
        </span>
        <span class="text-[11px] text-[#5e4b3b] italic mt-1 text-center px-2">
          Guarda tu imagen optimizada en: <br />
          <code class="bg-[#ebd9bd] px-1 py-0.5 rounded text-[10px] text-[#2c221a]">src/assets/foto-perfil.jpg</code>
        </span>
      </div>
    )}

    <!-- Trama de medio tono / grabado de imprenta sobre la foto -->
    <div class="halftone-screen" aria-hidden="true"></div>
  </div>

  <figcaption class="photo-caption">
    <span class="caption-title">{caption}</span>
    {subcaption && <span class="caption-subtitle">{subcaption}</span>}
  </figcaption>
</figure>

<style>
  .newspaper-photo-frame {
    display: inline-block;
    width: 100%;
    margin: 0 0 16px 0;
    padding: 8px;
    background-color: #f7f2e5;
    border: 2px solid #2b231d;
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.08),
      inset 0 0 0 1px #5c4b3d;
  }

  .photo-inner-border {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.8;
    background: #eedfc5;
    border: 1px solid #4a3c30;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  :global(.vintage-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Efecto de fotografía de prensa antigua: desaturada, alto contraste y tono cálido */
    filter: grayscale(0.85) contrast(1.15) sepia(0.25) brightness(0.96);
    mix-blend-mode: multiply;
  }

  .photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: repeating-linear-gradient(
      -45deg,
      #ebdcc2,
      #ebdcc2 8px,
      #e4d2b6 8px,
      #e4d2b6 16px
    );
  }

  /* Microtrama de periódico que imita los puntos de tinta de imprenta */
  .halftone-screen {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(#221c18 0.75px, transparent 0.75px);
    background-size: 3.5px 3.5px;
    opacity: 0.18;
    mix-blend-mode: multiply;
  }

  .photo-caption {
    margin-top: 6px;
    padding-top: 4px;
    border-top: 1px solid #4a3c30;
    text-align: center;
    font-family: var(--font-serif);
  }

  .caption-title {
    display: block;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #1e1814;
    line-height: 1.2;
  }

  .caption-subtitle {
    display: block;
    font-size: 11px;
    font-style: italic;
    color: #524235;
    margin-top: 2px;
    line-height: 1.2;
  }
</style>
